// Guardian Platform - Production-Grade PostgreSQL Database Schema
// Fully partitioned multi-tenant design with strict separation of:
// 1. Customer Tenant Administration (Personal & Organization)
// 2. Guardian Internal Control Plane (Guardian Super Admin IAM & Platform Ops)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. DOMAIN: IDENTITY (Customer Endpoints)
// ==========================================

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String       @unique
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz
  displayName       String?      @map("display_name")
  status            String       @default("ACTIVE") // ACTIVE, DISABLED
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz

  // Relations
  credentials       UserCredential[]
  identities        UserIdentity[]
  sessions          Session[]
  mfaMethods        MfaMethod[]
  memberships       TenantMembership[]
  devices           Device[]
  ownedTenants      Tenant[]     @relation("TenantOwner")
  recoveryRequests  RecoveryRequest[]

  @@map("users")
}

model UserCredential {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  credentialType  String    @map("credential_type") // PASSWORD, PASSKEY
  secretHash      String?   @map("secret_hash")
  publicKey       String?   @map("public_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserIdentity {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    // GOOGLE, OKTA, AZURE_AD
  providerSubject String    @map("provider_subject")
  linkedAt        DateTime  @default(now()) @map("linked_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("user_identities")
}

model Session {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  activeTenantId  String?   @map("active_tenant_id") @db.Uuid
  issuedAt        DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MfaMethod {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  methodType      String    @map("method_type") // TOTP, SMS, WEBAUTHN
  secretRef       String    @map("secret_ref")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_methods")
}

// ==========================================
// 2. DOMAIN: TENANCY & CUSTOMER RBAC
// ==========================================

model Tenant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String    // PERSONAL, ORGANIZATION
  name            String
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED, ARCHIVED
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  owner           User      @relation("TenantOwner", fields: [ownerUserId], references: [id])
  memberships     TenantMembership[]
  roles           Role[]
  groups          Group[]
  invitations     Invitation[]
  devices         Device[]
  policies        Policy[]
  subscriptions   Subscription[]
  securityEvents  SecurityEvent[]
  incidents       Incident[]
  alerts          Alert[]

  @@map("tenants")
}

model TenantMembership {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, REMOVED
  joinedAt        DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  removedAt       DateTime? @map("removed_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Role {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid // null = system default role
  name            String
  isSystemRole    Boolean   @default(true) @map("is_system_role")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     TenantMembership[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@map("roles")
}

model Permission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource        String    // device, policy, recovery, etc.
  action          String    // read, write, execute
  
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId          String    @map("role_id") @db.Uuid
  permissionId    String    @map("permission_id") @db.Uuid

  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Group {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     GroupMembership[]

  @@index([tenantId])
  @@map("groups")
}

model GroupMembership {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  memberType      String    @map("member_type") // DEVICE, USER
  memberId        String    @map("member_id") @db.Uuid
  addedAt         DateTime  @default(now()) @map("added_at") @db.Timestamptz

  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberType, memberId])
  @@map("group_memberships")
}

model Invitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  status          String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

// ==========================================
// 3. DOMAIN: DEVICES
// ==========================================

model Device {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  assignedUserId  String?   @map("assigned_user_id") @db.Uuid
  ownershipType   String    @default("PERSONAL") @map("ownership_type") // PERSONAL, COMPANY_OWNED, BYOD
  platform        String    // MACOS, WINDOWS, LINUX, IOS, ANDROID
  platformVersion String?   @map("platform_version")
  hostname        String?
  displayName     String?   @map("display_name")
  publicKey       String    @map("public_key")
  status          String    @default("REGISTERED") // ACTIVE, OFFLINE, AT_RISK, REVOKED
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz
  registeredAt    DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser    User?     @relation(fields: [assignedUserId], references: [id])
  installations   DeviceInstallation[]
  assignments     DeviceAssignment[]
  events          SecurityEvent[]
  incidents       Incident[]
  commandDeliveries CommandDelivery[]

  @@index([tenantId])
  @@map("devices")
}

model DeviceInstallation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  agentVersionId  String    @map("agent_version_id") @db.Uuid
  installedAt     DateTime  @default(now()) @map("installed_at") @db.Timestamptz

  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  agentVersion    AgentVersion @relation(fields: [agentVersionId], references: [id])

  @@map("device_installations")
}

model DeviceAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  unassignedAt    DateTime? @map("unassigned_at") @db.Timestamptz

  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_assignments")
}

model AgentVersion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform        String    // MACOS, WINDOWS, LINUX
  version         String
  signature       String
  releaseNotes    String?   @map("release_notes")
  minSupported    Boolean   @default(false) @map("min_supported")
  releasedAt      DateTime  @default(now()) @map("released_at") @db.Timestamptz

  installations   DeviceInstallation[]

  @@unique([platform, version])
  @@map("agent_versions")
}

// ==========================================
// 4. DOMAIN: SECURITY
// ==========================================

model SecurityEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  deviceId        String?   @map("device_id") @db.Uuid
  eventType       String    @map("event_type")
  category        String    // ENDPOINT, NETWORK, IDENTITY, MALWARE
  severity        String    // LOW, MEDIUM, HIGH, CRITICAL
  actionTaken     String    @map("action_taken")
  status          String    // BLOCKED, FLAGGED, ALLOWED, QUARANTINED
  payload         Json?
  timestamp       DateTime  @default(now()) @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device          Device?   @relation(fields: [deviceId], references: [id])
  incidentEvents  IncidentEvent[]

  @@index([tenantId, timestamp])
  @@map("security_events")
}

model Alert {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  title           String
  category        String
  severity        String    // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @default("PENDING") // PENDING, ACKNOWLEDGED, RESOLVED
  assignedTo      String?   @map("assigned_to")
  timestamp       DateTime  @default(now()) @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("alerts")
}

model Incident {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  deviceId        String?   @map("device_id") @db.Uuid
  title           String
  severity        String    // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @default("OPEN") // OPEN, INVESTIGATING, MITIGATED, RESOLVED
  riskScore       Int       @default(80) @map("risk_score")
  summary         String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device          Device?   @relation(fields: [deviceId], references: [id])
  incidentEvents  IncidentEvent[]

  @@index([tenantId, status])
  @@map("incidents")
}

model IncidentEvent {
  incidentId      String    @map("incident_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid

  incident        Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  event           SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([incidentId, eventId])
  @@map("incident_events")
}

model RiskScore {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String    @map("entity_type") // TENANT, USER, DEVICE
  entityId        String    @map("entity_id") @db.Uuid
  score           Int
  riskLevel       String    @map("risk_level") // LOW, MEDIUM, HIGH, CRITICAL
  calculatedAt    DateTime  @default(now()) @map("calculated_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@map("risk_scores")
}

model EvidenceMetadata {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String?   @map("event_id") @db.Uuid
  bucketKey       String    @map("bucket_key")
  sha256Hash      String    @map("sha256_hash")
  encryptionAlg   String    @map("encryption_alg")
  storedAt        DateTime  @default(now()) @map("stored_at") @db.Timestamptz

  @@map("evidence_metadata")
}

// ==========================================
// 5. DOMAIN: POLICY
// ==========================================

model Policy {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  description     String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions        PolicyVersion[]
  assignments     PolicyAssignment[]

  @@map("policies")
}

model PolicyVersion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId        String    @map("policy_id") @db.Uuid
  versionNumber   Int       @map("version_number")
  rulesJson       Json      @map("rules_json")
  publishedAt     DateTime  @default(now()) @map("published_at") @db.Timestamptz

  policy          Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, versionNumber])
  @@map("policy_versions")
}

model PolicyAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId        String    @map("policy_id") @db.Uuid
  targetType      String    @map("target_type") // TENANT, GROUP, DEVICE
  targetId        String    @map("target_id") @db.Uuid

  policy          Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("policy_assignments")
}

model PolicyException {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId        String    @map("policy_id") @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  reason          String
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz

  @@map("policy_exceptions")
}

model PolicyEvaluation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  policyId        String    @map("policy_id") @db.Uuid
  isCompliant     Boolean   @map("is_compliant")
  evaluatedAt     DateTime  @default(now()) @map("evaluated_at") @db.Timestamptz

  @@map("policy_evaluations")
}

// ==========================================
// 6. DOMAIN: RECOVERY & RESPONSE ACTIONS
// ==========================================

model RecoveryRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  status          String    @default("PENDING") // PENDING, VERIFIED, EXPIRED
  biometricToken  String?   @map("biometric_token")
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_requests")
}

model ResponseAction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  actionType      String    @map("action_type") // LOCK, WIPE, ISOLATE
  status          String    @default("QUEUED")
  dispatchedAt    DateTime  @default(now()) @map("dispatched_at") @db.Timestamptz

  @@map("response_actions")
}

model CommandDelivery {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  commandPayload  String    @map("command_payload")
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz
  acknowledgedAt  DateTime? @map("acknowledged_at") @db.Timestamptz

  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("command_deliveries")
}

// ==========================================
// 7. DOMAIN: BILLING & COMMERCE
// ==========================================

model Plan {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  tier            String    // FREE, PERSONAL, BUSINESS, BUSINESS_PLUS, ENTERPRISE
  targetType      String    @map("target_type") // PERSONAL, ORGANIZATION
  priceMonthly    Decimal   @map("price_monthly") @db.Decimal(10, 2)
  priceAnnual     Decimal   @map("price_annual") @db.Decimal(10, 2)
  deviceLimit     Int       @map("device_limit")
  employeeLimit   Int       @map("employee_limit")
  status          String    @default("ACTIVE")

  features        PlanFeature[]
  subscriptions   Subscription[]

  @@map("plans")
}

model PlanFeature {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String    @map("plan_id") @db.Uuid
  featureKey      String    @map("feature_key")
  featureValue    String    @map("feature_value")

  plan            Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_features")
}

model Subscription {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  planId          String    @map("plan_id") @db.Uuid
  status          String    // ACTIVE, TRIALING, PAST_DUE, CANCELED
  seatsAllocated  Int       @map("seats_allocated")
  devicesAllocated Int      @map("devices_allocated")
  mrr             Decimal   @db.Decimal(10, 2)
  billingInterval String    @map("billing_interval") // MONTHLY, ANNUAL
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  renewsAt        DateTime  @map("renews_at") @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            Plan      @relation(fields: [planId], references: [id])
  items           SubscriptionItem[]
  invoices        Invoice[]
  billingEvents   BillingEvent[]

  @@map("subscriptions")
}

model SubscriptionItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String    @map("subscription_id") @db.Uuid
  itemType        String    @map("item_type") // SEAT, DEVICE_PACK, STORAGE_ADDON
  quantity        Int

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_items")
}

model UsageRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  metricType      String    @map("metric_type") // EVENT_INGESTION, STORAGE_BYTES, AGENT_MTLS
  quantity        BigInt
  recordedAt      DateTime  @default(now()) @map("recorded_at") @db.Timestamptz

  @@index([tenantId, metricType])
  @@map("usage_records")
}

model Invoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String    @map("subscription_id") @db.Uuid
  amountDue       Decimal   @map("amount_due") @db.Decimal(10, 2)
  status          String    // PAID, OPEN, VOID, UNCOLLECTIBLE
  dueDate         DateTime  @map("due_date") @db.Timestamptz
  paidAt          DateTime? @map("paid_at") @db.Timestamptz

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model BillingEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String    @map("subscription_id") @db.Uuid
  eventType       String    @map("event_type")
  details         Json?
  timestamp       DateTime  @default(now()) @db.Timestamptz

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_events")
}

// ==========================================
// 8. DOMAIN: GUARDIAN INTERNAL IAM
// (Strictly Separate from Customer Tenancy)
// ==========================================

model GuardianAdminUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String    @unique
  roleKey         String    @map("role_key") // SUPER_ADMIN, OPERATIONS_ADMIN, SECURITY_ADMIN, SUPPORT_ADMIN, BILLING_ADMIN
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED
  mfaEnabled      Boolean   @default(true) @map("mfa_enabled")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz

  teamMemberships GuardianAdminTeamMembership[]

  @@map("guardian_admin_users")
}

model GuardianAdminRole {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleKey         String    @unique @map("role_key")
  name            String
  description     String?

  rolePermissions GuardianAdminRolePermission[]

  @@map("guardian_admin_roles")
}

model GuardianAdminPermission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String    @unique // e.g. organizations.suspend, platform.settings.manage
  resource        String
  action          String
  description     String?

  rolePermissions GuardianAdminRolePermission[]

  @@map("guardian_admin_permissions")
}

model GuardianAdminRolePermission {
  roleId          String    @map("role_id") @db.Uuid
  permissionId    String    @map("permission_id") @db.Uuid

  role            GuardianAdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      GuardianAdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("guardian_admin_role_permissions")
}

model GuardianAdminTeam {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  slackChannel    String?   @map("slack_channel")

  memberships     GuardianAdminTeamMembership[]

  @@map("guardian_admin_teams")
}

model GuardianAdminTeamMembership {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId     String    @map("admin_user_id") @db.Uuid
  teamId          String    @map("team_id") @db.Uuid

  adminUser       GuardianAdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  team            GuardianAdminTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, teamId])
  @@map("guardian_admin_team_memberships")
}

// ==========================================
// 9. DOMAIN: PLATFORM & OPERATIONAL STATE
// ==========================================

model FeatureFlag {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String    @unique
  name            String
  description     String?
  environment     String    // PRODUCTION, STAGING, ALL
  enabled         Boolean   @default(false)
  rolloutPercent  Int       @default(0) @map("rollout_percent")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy       String    @map("updated_by")

  @@map("feature_flags")
}

model PlatformSetting {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section         String    // general, security, authentication, notifications, storage, retention, integrations, defaults
  key             String
  value           Json
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([section, key])
  @@map("platform_settings")
}

model AgentRelease {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version         String
  platform        String    // MACOS, WINDOWS, LINUX
  releaseDate     DateTime  @default(now()) @map("release_date") @db.Timestamptz
  status          String    // ACTIVE, ROLLING_OUT, DEPRECATED
  adoptionRate    Float     @default(0.0) @map("adoption_rate")
  minSupported    Boolean   @default(false) @map("min_supported")
  checksumSha256  String    @map("checksum_sha256")
  releaseNotes    String?   @map("release_notes")

  @@unique([version, platform])
  @@map("agent_releases")
}

model ServiceHealth {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  category        String
  status          String    // HEALTHY, DEGRADED, OUTAGE
  latencyMs       Int       @map("latency_ms")
  uptimePercent   Float     @map("uptime_percent")
  lastCheckedAt   DateTime  @default(now()) @map("last_checked_at") @db.Timestamptz
  region          String

  @@map("service_health")
}

// ==========================================
// 10. DOMAIN: AUDIT & DATA ACCESS LOGS
// ==========================================

model AuditLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp       DateTime  @default(now()) @db.Timestamptz
  actorName       String    @map("actor_name")
  actorEmail      String    @map("actor_email")
  actorRole       String    @map("actor_role")
  action          String
  resource        String
  resourceId      String    @map("resource_id")
  result          String    // SUCCESS, FAILURE, DENIED
  ipAddress       String    @map("ip_address")
  requestId       String    @map("request_id")
  category        String    // ADMIN_ACTION, SECURITY_ACTION, DATA_ACCESS
  isSensitive     Boolean   @default(false) @map("is_sensitive")
  details         Json?

  @@index([timestamp])
  @@index([category])
  @@map("audit_logs")
}

model DataAccessLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp       DateTime  @default(now()) @db.Timestamptz
  actorEmail      String    @map("actor_email")
  tenantId        String    @map("tenant_id") @db.Uuid
  targetResource  String    @map("target_resource")
  justification   String
  ipAddress       String    @map("ip_address")

  @@index([tenantId, timestamp])
  @@map("data_access_logs")
}
