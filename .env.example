# Guardian Cloud local defaults (copy to deployments/.env if needed)
POSTGRES_PASSWORD=guardian
DATABASE_URL=postgres://guardian:guardian@127.0.0.1:5434/guardian_cloud?sslmode=disable
REDIS_URL=redis://127.0.0.1:6381/0
PORT=8083
PUBLIC_BASE_URL=http://127.0.0.1:8083
PUBLIC_WEB_URL=http://127.0.0.1:5175
# Temporary platform gate for theme PUT, retired once AUTH_LEGACY_MODE=off
GUARDIAN_PLATFORM_DEV_TOKEN=guardian-dev-super-admin

# Auth. AUTH_LEGACY_MODE: on = accept X-User-Id / dev-token fallbacks alongside
# real sessions, warn = accept but log and audit them, off = reject.
AUTH_LEGACY_MODE=on
AUTH_COOKIE_SECURE=false
# Seals TOTP secrets and OIDC client secrets. Backup-critical: losing it orphans
# every enrolled authenticator. Generate with: openssl rand -base64 32
GUARDIAN_SECRET_ENCRYPTION_KEY=iQ+MN48n2jzZxlBLRay+SimIww5tag+QLQpqCjmMVOU=
# Proxies whose X-Forwarded-For we trust. Empty means the header is ignored and
# the transport peer wins. Set this when a load balancer is introduced.
TRUSTED_PROXY_CIDRS=

# Mail (Mailpit in local dev — web UI at http://127.0.0.1:8026)
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=Guardian <no-reply@guardian.local>
