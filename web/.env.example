# The API is reached through the app's own origin by default (Vite proxies
# /api to the backend), which keeps session cookies first-party. Only set
# VITE_API_BASE_URL if the API cannot be served under this origin.
# VITE_API_BASE_URL=

# Retired with AUTH_LEGACY_MODE=off; kept while the legacy theme path exists.
VITE_PLATFORM_DEV_TOKEN=guardian-dev-super-admin
